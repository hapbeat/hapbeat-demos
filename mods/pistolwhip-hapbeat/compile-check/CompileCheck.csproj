<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       ゲームを持っていない環境でのビルド検証用。
       mod のソース + 共通コア + stubs/ をまとめてコンパイルし、
       「構文・型・API 呼び出しが噛み合っているか」だけを確認する。
       製品 DLL はこちらでは作らない (src/PistolWhipHapbeat.csproj が正)。

         dotnet build mods/pistolwhip-hapbeat/compile-check

       stubs は実 DLL と同一である保証がないため、これが通っても
       所有者環境でのビルド成功は保証しない (README の実機確認チェックリスト参照)。
       ========================================================================== -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PistolWhipHapbeat.CompileCheck</AssemblyName>
    <RootNamespace>Hapbeat.PistolWhip</RootNamespace>
    <!-- 警告を残さない: stubs 相手のビルドで出る警告は本番でも出る -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- コンパイル対象は下の ItemGroup で明示する (このフォルダ配下を暗黙に拾わない) -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 成果物は捨てるだけなので参照 DLL のコピーも不要 -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- src/PistolWhipHapbeat.csproj と同じ既定にそろえる。stubs 側の名前空間も
         この定数で切り替わるので、両方の姿を検証できる:
           dotnet build compile-check                              (Il2Cpp 名前空間)
           dotnet build compile-check -p:KoreoIl2CppNamespace=false (素の名前空間)
           dotnet build compile-check -p:DefineConstants=HAPBEAT_NO_BEATSYNC (拍なし) -->
    <KoreoIl2CppNamespace Condition="'$(KoreoIl2CppNamespace)' == ''">true</KoreoIl2CppNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(KoreoIl2CppNamespace)' == 'true'">
    <DefineConstants>$(DefineConstants);HAPBEAT_KOREO_IL2CPP_NS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- src\ を再帰で拾うので、src 側をビルド済みの環境で obj\**\*.AssemblyInfo.cs を
         巻き込まないよう除外する (拾うと CS0579 属性重複でビルドが落ちる) -->
    <Compile Include="..\src\**\*.cs" Exclude="..\src\bin\**\*.cs;..\src\obj\**\*.cs" LinkBase="src" />
    <Compile Include="..\stubs\*.cs" LinkBase="stubs" />
    <Compile Include="..\..\shared\HapbeatModCore\*.cs" LinkBase="HapbeatModCore" />
  </ItemGroup>

</Project>
